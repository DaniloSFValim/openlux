{
  // Worker de arquivos estaticos do OpenLux (sem codigo de servidor).
  // O nome deve coincidir com o Worker existente na Cloudflare ("openlux").
  "name": "openlux",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./web"
  },
  // Exigido por `npx wrangler preview` (comando de build de preview da Cloudflare). Bloco vazio: sem configuração extra de preview.
  "previews": {}
}
